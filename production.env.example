# Copy this file to production.env or .env next to compose.production.yml.
# Never commit your filled environment file. Keep the single quotes around DOSSIER_PASSWORD;
# Argon2id password hashes contain '

POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
POSTGRES_DB=dossier
DOSSIER_PASSWORD='PASTE_ARGON2ID_HASH_HERE'
DOSSIER_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# CI publishes this preview tag after all checks pass on feat/india-hourly-job-agent.
# After the PR is merged, change to ghcr.io/narendramohanmishraa/dossier:main.
DOSSIER_IMAGE=ghcr.io/narendramohanmishraa/dossier:feat-india-hourly-job-agent
DOSSIER_PORT=3000
TZ=Asia/Kolkata

# Optional: configure job source and AI in Settings after sign-in instead.
# For the capped job agent, 180 source requests are allowed per rolling 30 days.
# JSearch's free allowance is listed by Dossier as 200 per month.
DOSSIER_JOBS_SOURCE=freehire
# DOSSIER_JSEARCH_KEY=
# DOSSIER_JSEARCH_HOST=openwebninja
# DOSSIER_ADZUNA_APP_ID=
# DOSSIER_ADZUNA_KEY=

# Optional AI defaults. A hosted or local provider can also be configured in Settings.
# DOSSIER_AI_PROVIDER=openai
# DOSSIER_AI_URL=https://api.openai.com/v1
# DOSSIER_AI_MODEL=your-model
# DOSSIER_AI_KEY=
# DOSSIER_AI_TIMEOUT_SECONDS=120

# If a reverse proxy serves Dossier at a public HTTPS address, set it here.
# DOSSIER_PUBLIC_URL=https://dossier.example.com

# Generate the Dossier login hash after pulling the published image:
# docker run --rm -it ghcr.io/narendramohanmishraa/dossier:feat-india-hourly-job-agent hash-password
# Generate a password and session secret:
# openssl rand -hex 24
# openssl rand -base64 48
 and Compose must not interpolate them.

POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
DOSSIER_PASSWORD='PASTE_ARGON2ID_HASH_HERE'
DOSSIER_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# CI publishes this preview tag after all checks pass on feat/india-hourly-job-agent.
# After the PR is merged, change to ghcr.io/narendramohanmishraa/dossier:main.
DOSSIER_IMAGE=ghcr.io/narendramohanmishraa/dossier:feat-india-hourly-job-agent
DOSSIER_PORT=3000
TZ=Asia/Kolkata

# Optional: configure job source and AI in Settings after sign-in instead.
# For the capped job agent, 180 source requests are allowed per rolling 30 days.
# JSearch's free allowance is listed by Dossier as 200 per month.
DOSSIER_JOBS_SOURCE=freehire
# DOSSIER_JSEARCH_KEY=
# DOSSIER_JSEARCH_HOST=openwebninja
# DOSSIER_ADZUNA_APP_ID=
# DOSSIER_ADZUNA_KEY=

# Optional AI defaults. A hosted or local provider can also be configured in Settings.
# DOSSIER_AI_PROVIDER=openai
# DOSSIER_AI_URL=https://api.openai.com/v1
# DOSSIER_AI_MODEL=your-model
# DOSSIER_AI_KEY=
# DOSSIER_AI_TIMEOUT_SECONDS=120

# If a reverse proxy serves Dossier at a public HTTPS address, set it here.
# DOSSIER_PUBLIC_URL=https://dossier.example.com

# Generate the Dossier login hash after pulling the published image:
# docker run --rm -it ghcr.io/narendramohanmishraa/dossier:feat-india-hourly-job-agent hash-password
# Generate a password and session secret:
# openssl rand -hex 24
# openssl rand -base64 48
