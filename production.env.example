# Copy to production.env. Never commit your completed production.env.
# The production Caddy profile requires a public DNS name pointing to this host.
COMPOSE_PROFILES=https
DOSSIER_DOMAIN=dossier.example.com
DOSSIER_PUBLIC_URL=https://dossier.example.com

POSTGRES_USER=postgres
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
POSTGRES_DB=dossier

# Generate a Dossier login hash using the published image's hash-password command.
# Keep the single quotes: Argon2id hashes contain characters interpreted by Compose.
DOSSIER_PASSWORD='PASTE_ARGON2ID_HASH_HERE'
# Generate with: openssl rand -hex 48
DOSSIER_SECRET=REPLACE_WITH_RANDOM_HEX_SECRET

# CI publishes this preview tag after lint, type-check, tests and E2E pass.
# After merging the PR to main, switch this to ghcr.io/narendramohanmishraa/dossier:main.
DOSSIER_IMAGE=ghcr.io/narendramohanmishraa/dossier:feat-india-hourly-job-agent
DOSSIER_PORT=3000
TZ=Asia/Kolkata

# Optional: set the provider defaults here or configure them in Dossier Settings.
DOSSIER_JOBS_SOURCE=freehire
# DOSSIER_JSEARCH_KEY=
# DOSSIER_JSEARCH_HOST=openwebninja
# DOSSIER_ADZUNA_APP_ID=
# DOSSIER_ADZUNA_KEY=
# DOSSIER_FREEHIRE_URL=

# Optional AI defaults; these can also be configured in Settings -> AI provider.
# DOSSIER_AI_PROVIDER=openai
# DOSSIER_AI_URL=https://api.openai.com/v1
# DOSSIER_AI_MODEL=your-model
# DOSSIER_AI_KEY=
# DOSSIER_AI_TIMEOUT_SECONDS=120

DOSSIER_BACKUP_RETENTION_DAYS=14
DOSSIER_TELEMETRY=off

# Job agent defaults: one search every four hours, hard cap of 180 searches
# in a rolling 30-day window. The AI review queue only admits 95/100+ matches.
# Separate Find jobs searches may consume the same provider allowance.
